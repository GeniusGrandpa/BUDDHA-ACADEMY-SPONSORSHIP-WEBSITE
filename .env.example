
# Buddha Academy  environment template
#
# Copy this file to `.env` and fill in your values.
# NEVER commit your real `.env` (it is git-ignored).
#
# What goes where:
#   • `VITE_*` vars below → read by Vite (bundled into the browser)
#   • Server vars          → read by `server/index.mjs` (Node, not bundled)
#   • Edge Function secrets→ NOT read from `.env`; set with
#                            `supabase secrets set ...` (see README)


VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Public origin used for auth redirects and as the base for the eSewa/Khalti
# return URLs (the frontend sends this to esewa-pay / khalti-pay).
VITE_PUBLIC_BASE_URL=http://localhost:5174
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# DATABASE_URL=postgresql://postgres.<ref>@<region>.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=server/certs/prod-ca-2021.crt
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/jwks.json


# Do NOT place these in `.env`. Configure them in Supabase with:
#   supabase secrets set VAR_NAME=value
# The frontend never sees them.

# Stripe (create-payment-intent / stripe-webhook)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# eSewa (esewa-pay / esewa-callback)
# ESEWA_ENVIRONMENT=uat
# ESEWA_MERCHANT_CODE=EPAYTEST
# ESEWA_SECRET_KEY=...
# ESEWA_RETURN_URL=https://your-public-domain.example
#   ^ Optional fallback. The frontend normally sends VITE_PUBLIC_BASE_URL,
#     which takes precedence; this secret is used only when the client
#     does not provide a return URL.

# Khalti (khalti-pay / khalti-callback)
# KHALTI_ENVIRONMENT=test
# KHALTI_SECRET_KEY=live_secret_key_...
# KHALTI_WEBSITE_URL=https://your-public-domain.example
# KHALTI_RETURN_URL=https://your-public-domain.example
#   ^ Optional fallback. The frontend normally sends VITE_PUBLIC_BASE_URL,
#     which takes precedence; this secret is used only when the client
#     does not provide a return URL.
