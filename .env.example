# =============================================================================
# Buddha Academy Sponsorship Website — Environment Variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- Supabase (public) -------------------------------------------------------
# Project URL: Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key (safe to expose; Row Level Security protects the data)
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- App ---------------------------------------------------------------------
# Public base URL of the deployed site (no trailing slash).
# Used for canonical URLs / SEO.
VITE_PUBLIC_BASE_URL=https://your-domain.com

# --- Stripe ------------------------------------------------------------------
# Publishable key (client-safe): Dashboard -> Developers -> API keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Secret key — SERVER ONLY. Also set via:
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_SECRET_KEY=sk_test_xxx
# Webhook signing secret (whsec_...) for the stripe-webhook edge function.
# Create the webhook in the Stripe Dashboard pointing at
#   https://<project-ref>.supabase.co/functions/v1/stripe-webhook
# and subscribe to: payment_intent.succeeded, payment_intent.payment_failed,
# payment_intent.canceled. Set via:
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Service-role key used by edge functions (auto-injected in production by
# Supabase; set it locally via `supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...`)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Production server (server/index.mjs) ------------------------------------
HOST=0.0.0.0
PORT=3000

# --- Direct PostgreSQL access (OPTIONAL — admin/tooling only) ----------------
# Used by psql, pgAdmin, DBeaver or server-side scripts. The app itself talks
# to Supabase exclusively over HTTPS (REST), so these are not required to run.
# Always use the transaction pooler (port 6543) for short-lived connections and
# keep `sslmode=verify-full` so the server certificate is validated against the
# CA bundle in server/certs/prod-ca-2021.crt.
#   get from: Dashboard -> Project Settings -> Database -> Connection string
#DATABASE_URL=postgresql://postgres.your-project-ref@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=verify-full&sslrootcert=server/certs/prod-ca-2021.crt
